# m22 (MEIZU 22, Flyme 12.6 / Android16, 高通 sun/QSSI) 内核项目层 config。
# 移植自 15R-16：内核为通用 lineage-23.2 virtio GKI（非 SoC 厂商内核），与设备平台无关。
# merge_config 顺序在官方 lineageos/virtio.config + peripheral/wifi.config 之后，
# 放项目层而非内核源树，避免 git commit。

# CDH: pioneer 域（guest 值守 daemon + 其 adb shell/sync 子进程）内核强制 permissive。
# 本盘 init 内嵌 secilc 不支持 CIL permissive 语句，策略侧无法自声明；permissive_map
# 置位后所有以 pioneer 为主体的 AVC 判定放行（审计保留），策略段无需再逐条枚举。
# 补丁见 kernel/source/security/selinux/{Kconfig,ss/services.c}（cdh_mark_pioneer_permissive）。
CONFIG_CDH_PIONEER_PERMISSIVE=y

# v7：mac80211_hwsim —— 真无线（wlan0 station + wlan1 AP radio，netns 隔离），
# 消除 virt_wifi 的以太网 backing（buried_eth1），使 App 可见接口对齐真机。
# 官方 lineage-23.2 源码已含 drivers/net/wireless/virtual/mac80211_hwsim.c。
# 本机依赖已由 vendor 侧策略坐实：build/vendor/build/sepolicy.py 的 W 段给
# hal_wifi_default 开 /dev/hvc9 控制面 + /dev/hvc10 数据面（内核直桥）并标
# /module/mac80211_hwsim/parameters/scan_profile 为独立 sysfs 类型。
CONFIG_MAC80211=m
CONFIG_MAC80211_HWSIM=m
# mac80211.ko 加载报 Unknown symbol arc4_setkey/arc4_crypt：arc4 lib 必须内建
CONFIG_CRYPTO_LIB_ARC4=y
